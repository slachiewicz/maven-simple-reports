.idea/
*.iml

public/*.html
!public/index.html
public/*.csv
public/dependabot-prs/
cache/
data/
# Ignore .claude/ contents (worktrees, local settings) but track the skill
# symlinks, so a clone gets working skills without a manual re-link step.
# Must be `.claude/*` not `.claude/` — git cannot re-include a path whose
# parent directory is itself excluded.
.claude/*
!.claude/skills/

# Local Netlify folder
.netlify

# Netlify Functions deps — installed by CI before deploy
netlify/node_modules/

# Installed dependencies anywhere (web/, and any stray root install)
node_modules/
